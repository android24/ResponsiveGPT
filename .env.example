# Copy this file to .env or config/accounts.local.json.
# Never put real credentials in files that are committed to Git.

JIEKOU_API_KEY=
JIEKOU_BASE_URL=https://api.jiekou.ai/openai
PRIMARY_MODEL=gpt-5.2
FALLBACK_MODEL=gpt-4.1
CHEAP_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

KB_DIR=src/responsivegpt/data/kb
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
LLM_MAX_COMPLETION_TOKENS=2048
