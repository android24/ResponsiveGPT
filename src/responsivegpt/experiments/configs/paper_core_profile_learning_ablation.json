  "defaults": {
    "mode": "episode",
    "limit": 0,
    "job_timeout_s": 43200,
    "model_role": "cheap",
    "feedback": "Prioritize safety, legal compliance, and interaction smoothness while avoiding clearly dangerous operations.",
    "feedback_by_profile": {
      "aggressive": "The current behavior is too slow. Improve progress efficiency when safety and traffic law permit.",
      "balanced": "Balance safety, legal compliance, interaction smoothness, and reasonable progress efficiency.",
      "conservative": "The current behavior feels unsafe. Prioritize safety margins and legal compliance."
    },
    "extra_args": {
      "reuse_last_decision": 1,
      "use_trigger": 1,
      "history_window": 10,
      "rag_budget": "reactive_low",
      "rag_top_k": 8,
      "trace_detail": 0,
      "frame_selection": "all",
      "llm_max_stale_frames": 30,
      "llm_risk_delta_threshold": 0.15,
      "llm_error_cooldown_frames": 30,
      "rag_evidence_debounce_frames": 10,
      "rag_evidence_signature_top_k": 3,
      "grounding_refresh_debounce_frames": 10,
      "use_case_memory": 1,
      "case_memory_top_k": 3,
      "case_memory_min_similarity": 0.72,
      "case_memory_novelty_threshold": 0.45,
      "case_memory_include_in_prompt": 1,
      "use_budget_governor": 1,
      "budget_governor_warn_ratio": 0.8,
      "budget_governor_critical_ratio": 0.95,
      "max_wall_time_s": 21600,
      "planning_interval": 100,
      "planning_min_gap": 100,
      "planning_risk_threshold": 0.60,
      "planning_max_history": 8,
      "planning_peek": 1,
      "feedback_once_per_episode": 1,
      "profile_protocol_enabled": 1,
      "profile_adaptation_episodes": 10,
      "profile_adaptation_pool_episodes": 10,
      "profile_adaptation_allocation": "neyman"
    }
  },
