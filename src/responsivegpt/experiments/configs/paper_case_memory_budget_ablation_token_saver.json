{
  "name": "paper_case_memory_budget_ablation_token_saver",
  "dataset_registry_path": "datasets.json",
  "datasets": {
    "highd": {
      "summary_csv": "data/eval_samples/core_v1/highd_core_sample_seed20260613.csv",
      "sequence_root": "data/highD/clips_multi_fixed_window"
    },
    "ind": {
      "summary_csv": "data/eval_samples/core_v1/ind_core_sample_seed20260613.csv",
      "sequence_root": "data/inD/output_ind_risk_v4"
    },
    "round": {
      "summary_csv": "data/eval_samples/core_v1/round_core_sample_seed20260613.csv",
      "sequence_root": "data/rounD/output_high_risk"
    }
  },
  "defaults": {
    "mode": "episode",
    "limit": 0,
    "job_timeout_s": 43200,
    "model_role": "cheap",
    "feedback": "Prioritize safety, legal compliance, and interaction smoothness while avoiding clearly dangerous operations.",
    "llm_stride": 30,
    "llm_risk_threshold": 0.45,
    "extra_args": {
      "reuse_last_decision": 1,
      "use_trigger": 1,
      "use_profile_learner": 1,
      "history_window": 10,
      "rag_budget": "reactive_low",
      "rag_top_k": 8,
      "trace_detail": 0,
      "frame_selection": "all",
      "llm_max_stale_frames": 30,
      "llm_risk_delta_threshold": 0.15,
      "llm_error_cooldown_frames": 30,
      "rag_evidence_debounce_frames": 10,
      "rag_evidence_signature_top_k": 3,
      "grounding_refresh_debounce_frames": 10,
      "case_memory_top_k": 3,
      "case_memory_min_similarity": 0.72,
      "case_memory_novelty_threshold": 0.45,
      "case_memory_include_in_prompt": 1,
      "budget_governor_warn_ratio": 0.8,
      "budget_governor_critical_ratio": 0.95,
      "max_wall_time_s": 0,
      "planning_interval": 100,
      "planning_min_gap": 100,
      "planning_risk_threshold": 0.60,
      "planning_max_history": 8
    }
  },
  "matrix": {
    "datasets": [
      "highd",
      "ind",
      "round"
    ],
    "profiles": [
      "aggressive",
      "balanced",
      "conservative"
    ],
    "rag_variants": [
      {
        "name": "full_rag_grounded",
        "use_retriever": 1,
        "rag_mode": "full",
        "require_grounded_decision": 1
      }
    ],
    "planning": [
      {
        "name": "planning_on_adaptive",
        "use_planning_thread": 1,
        "planning_mode": "interval_risk",
        "extra_args": {
          "planning_peek": 1
        }
      }
    ],
    "llm_policies": [
      {
        "name": "no_memory_no_governor",
        "llm_policy": "event_triggered",
        "llm_stride": 30,
        "llm_risk_threshold": 0.45,
        "extra_args": {
          "use_case_memory": 0,
          "use_budget_governor": 0
        }
      },
      {
        "name": "case_memory_only",
        "llm_policy": "event_triggered",
        "llm_stride": 30,
        "llm_risk_threshold": 0.45,
        "extra_args": {
          "use_case_memory": 1,
          "use_budget_governor": 0
        }
      },
      {
        "name": "budget_governor_only",
        "llm_policy": "event_triggered",
        "llm_stride": 30,
        "llm_risk_threshold": 0.45,
        "extra_args": {
          "use_case_memory": 0,
          "use_budget_governor": 1
        }
      },
      {
        "name": "case_memory_budget_governor",
        "llm_policy": "event_triggered",
        "llm_stride": 30,
        "llm_risk_threshold": 0.45,
        "extra_args": {
          "use_case_memory": 1,
          "use_budget_governor": 1
        }
      }
    ]
  }
}
