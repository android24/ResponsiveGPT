{
  "name": "paper_fullpool_sparse_balanced_token_saver",
  "dataset_registry_path": "datasets.json",
  "datasets": [
    "highd",
    "ind",
    "round"
  ],
  "defaults": {
    "mode": "episode",
    "limit": 0,
    "job_timeout_s": 7200,
    "model_role": "cheap",
    "feedback": "Prioritize safety, legal compliance, and interaction smoothness while avoiding clearly dangerous operations.",
    "llm_stride": 60,
    "llm_risk_threshold": 0.50,
    "extra_args": {
      "reuse_last_decision": 1,
      "use_trigger": 1,
      "use_profile_learner": 1,
      "history_window": 10,
      "rag_budget": "reactive_low",
      "rag_top_k": 6,
      "trace_detail": 0,
      "frame_selection": "critical",
      "critical_top_k": 5,
      "llm_max_stale_frames": 120,
      "llm_risk_delta_threshold": 0.25,
      "llm_error_cooldown_frames": 30,
      "rag_evidence_debounce_frames": 10,
      "rag_evidence_signature_top_k": 3,
      "grounding_refresh_debounce_frames": 10,
      "use_case_memory": 1,
      "case_memory_top_k": 3,
      "case_memory_min_similarity": 0.72,
      "case_memory_novelty_threshold": 0.45,
      "case_memory_include_in_prompt": 1,
      "use_budget_governor": 1,
      "budget_governor_warn_ratio": 0.8,
      "budget_governor_critical_ratio": 0.95,
      "max_wall_time_s": 5400,
      "planning_interval": 500,
      "planning_min_gap": 500,
      "planning_risk_threshold": 0.65,
      "planning_max_history": 6
    }
  },
  "matrix": {
    "datasets": [
      "highd",
      "ind",
      "round"
    ],
    "profiles": [
      "balanced"
    ],
    "rag_variants": [
      {
        "name": "full_rag_grounded",
        "use_retriever": 1,
        "rag_mode": "full",
        "require_grounded_decision": 1
      }
    ],
    "planning": [
      {
        "name": "planning_on_interval",
        "use_planning_thread": 1,
        "planning_mode": "interval"
      }
    ],
    "llm_policies": [
      {
        "name": "event_triggered_sparse",
        "llm_policy": "event_triggered",
        "llm_stride": 60,
        "llm_risk_threshold": 0.50
      }
    ],
    "shards": {
      "highd": 80,
      "ind": 400,
      "round": 20
    }
  }
}
